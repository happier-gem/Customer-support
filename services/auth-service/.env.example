NODE_ENV=development

AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/customer_support?schema=public"

# Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must match the values configured in services/gateway/.env
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=60
PASSWORD_RESET_EXPIRES_IN_MINUTES=30

FRONTEND_URL=http://localhost:3000

# Optional SMTP configuration. If SMTP_HOST is left empty, emails are logged
# to the console instead of sent (dev-safe fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Customer Support Portal <no-reply@example.com>"
