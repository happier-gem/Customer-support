generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant company. Phase 1 only establishes the shape of this entity;
/// tenant-isolation enforcement (guards/middleware) is implemented in Phase 2.
/// Phase 3 adds the company-profile fields (logo, timezone) managed from
/// the org's own "/organizations/me" settings page.
/// Phase 6: the three fixed subscription tiers. Limits for each are business
/// constants (see packages/shared/src/constants/subscription.ts), not stored
/// per-row here — with only 3 non-tenant-editable plans and no Platform Admin
/// plan-management yet (that's Phase 9), a `plan` enum on Organization is the
/// smallest correct design. A future Phase 9 that lets Platform Admin edit
/// limits would migrate PLAN_LIMITS into a real table at that point; nothing
/// about this shape blocks that later change.
enum PlanType {
  FREE
  STARTER
  PRO
}

model Organization {
  id       String  @id @default(uuid())
  name     String
  logoUrl  String?
  timezone String  @default("UTC")

  /// Every organization always has a plan — defaults to FREE at registration
  /// so no organization can ever bypass feature limits via a null plan.
  plan PlanType @default(FREE)

  /// Phase 9: a platform-level hold, set only by PLATFORM_ADMIN via the admin API
  /// (AdminService.setSuspended) — distinct from User.isActive, which is a per-member
  /// deactivation a Tenant Owner controls for their own team. A suspended organization's
  /// users cannot log in or refresh their session (AuthService.login/refresh); a
  /// PLATFORM_ADMIN caller is exempt from this check everywhere it's enforced, since
  /// suspension is a tool platform admin applies *to* tenants, never to itself.
  isSuspended Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  invitations   Invitation[]
  tickets       Ticket[]
  feedbackForms FeedbackForm[]
  notifications Notification[]

  @@map("organizations")
}

/// Roles are modeled now so the schema doesn't need to change shape in
/// Phase 2, but no RBAC/permission logic is enforced against this field yet.
enum UserRole {
  PLATFORM_ADMIN
  TENANT_OWNER
  SUPPORT_AGENT
  CUSTOMER
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TENANT_OWNER)

  /// Phase 3 team-member removal deactivates rather than deletes, to
  /// preserve historical data (e.g. anything the user authored later).
  /// A deactivated user can no longer log in.
  isActive Boolean @default(true)

  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  refreshTokenHash String?

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentInvitations Invitation[] @relation("InvitationInviter")

  ticketsAsCustomer   Ticket[]           @relation("TicketCustomer")
  ticketsAsAgent      Ticket[]           @relation("TicketAssignedAgent")
  ticketAttachments   TicketAttachment[]
  ticketHistoryEvents TicketHistory[]

  feedbackFormsCreated FeedbackForm[]     @relation("FeedbackFormCreator")
  feedbackResponses    FeedbackResponse[] @relation("FeedbackResponseCustomer")

  notifications Notification[] @relation("NotificationRecipient")

  @@index([organizationId])
  @@index([emailVerificationTokenHash])
  @@index([passwordResetTokenHash])
  @@map("users")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// A pending (or resolved) invite for a teammate to join an organization
/// with a specific role. The raw token is emailed to the invitee and never
/// persisted — only its hash is stored, and it is looked up/compared the
/// same way password-reset/email-verification tokens are (see auth/utils/token.util.ts).
model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email String
  role  UserRole

  tokenHash String           @unique
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)

  invitedBy String
  inviter   User   @relation("InvitationInviter", fields: [invitedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketHistoryAction {
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  UPDATED
  ATTACHMENT_ADDED
}

/// Phase 4: a customer's support ticket, always owned by exactly one
/// organization. `organizationId` is set once at creation from the caller's
/// verified auth context and is never re-derived from client input — every
/// query in TicketsService filters by it.
model Ticket {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A User is never actually hard-deleted in this app (team-member removal
  // soft-deactivates — see User.isActive), so `onDelete: Cascade` here never
  // fires in production. It exists so that Organization -> User and
  // Organization -> Ticket -> TicketHistory/TicketAttachment, which both
  // cascade from the same Organization delete, don't race: without it,
  // Postgres can attempt to cascade-delete a User before the Ticket-side
  // cascade has removed the rows that still reference them, violating this
  // FK. Same reasoning applies to TicketAttachment.uploadedBy and
  // TicketHistory.actor below.
  customerId String
  customer   User   @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  assignedAgentId String?
  assignedAgent   User?   @relation("TicketAssignedAgent", fields: [assignedAgentId], references: [id])

  title       String
  description String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  attachments TicketAttachment[]
  history     TicketHistory[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, assignedAgentId])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt])
  @@map("tickets")
}

/// A file attached to a ticket. `storedFileName` is a server-generated,
/// non-guessable name on disk — the client-supplied `fileName` is display-only
/// and never used to build a filesystem path (mirrors organizations/logo-upload.config.ts).
model TicketAttachment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Denormalized from the parent ticket so attachment lookups can be
  /// tenant-scoped directly, without requiring a join for every access check.
  organizationId String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  fileName       String
  storedFileName String
  mimeType       String
  size           Int

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([organizationId])
  @@map("ticket_attachments")
}

/// Append-only audit trail scoped to a single ticket (not the Phase 8 global
/// audit log). `organizationId` is denormalized for the same reason as on
/// TicketAttachment: tenant-scoped history queries without a join.
model TicketHistory {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  organizationId String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  action         TicketHistoryAction
  previousStatus TicketStatus?
  newStatus      TicketStatus?
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([organizationId])
  @@map("ticket_history")
}

enum FeedbackCategory {
  SUPPORT
  PRODUCT
  SERVICE
  GENERAL
  OTHER
}

/// A form starts INACTIVE so a Tenant Owner can build out its questions
/// before customers can see or submit to it, then explicitly activates it.
enum FeedbackFormStatus {
  ACTIVE
  INACTIVE
}

enum FeedbackQuestionType {
  RATING
  TEXT
}

/// Phase 5: a tenant-owned survey. Always associated with exactly one
/// organization, set once at creation from the caller's verified auth
/// context — never re-derived from client input (mirrors Ticket above).
model FeedbackForm {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("FeedbackFormCreator", fields: [createdById], references: [id], onDelete: Cascade)

  title       String
  description String?
  category    FeedbackCategory   @default(GENERAL)
  status      FeedbackFormStatus @default(INACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions FeedbackQuestion[]
  responses FeedbackResponse[]

  @@index([organizationId, status])
  @@index([organizationId, category])
  @@map("feedback_forms")
}

/// A single custom question on a form. `organizationId` is denormalized from
/// the parent form for tenant-scoped lookups without a join, the same
/// rationale as TicketAttachment.organizationId above. `type` is immutable
/// after creation (see UpdateFeedbackQuestionDto) so it can never drift out
/// of sync with answers already stored against it.
model FeedbackQuestion {
  id     String       @id @default(uuid())
  formId String
  form   FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  organizationId String

  type     FeedbackQuestionType
  label    String
  required Boolean              @default(true)
  order    Int                  @default(0)

  /// TEXT only; RATING is always validated as an integer 1-5 with no configuration needed.
  maxLength Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers FeedbackAnswer[]

  @@index([formId, order])
  @@index([organizationId])
  @@map("feedback_questions")
}

/// One customer's submission to a form. `customerId` is always populated —
/// for tenant isolation, abuse/duplicate prevention, and so a customer can
/// look up their own submission history — even when `anonymous` is true.
/// Anonymity is a *display* concern enforced centrally in
/// FeedbackService's response-to-DTO mapping (see toResponseDto), never by
/// omitting ownership data at the database layer.
model FeedbackResponse {
  id     String       @id @default(uuid())
  formId String
  form   FeedbackForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  organizationId String

  customerId String
  customer   User   @relation("FeedbackResponseCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  anonymous Boolean @default(false)

  createdAt DateTime @default(now())

  answers FeedbackAnswer[]

  @@index([formId, createdAt])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@map("feedback_responses")
}

/// A single answer within a response, to a single question. Exactly one of
/// `ratingValue` / `textValue` is populated, matching the answered
/// question's `type` (validated in FeedbackService before the transaction
/// that creates these rows).
model FeedbackAnswer {
  id String @id @default(uuid())

  responseId String
  response   FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  questionId String
  question   FeedbackQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  organizationId String

  ratingValue Int?
  textValue   String?

  createdAt DateTime @default(now())

  @@index([responseId])
  @@index([questionId])
  @@index([organizationId])
  @@map("feedback_answers")
}

/// Phase 8: the notification event types the app actually generates — see
/// NotificationsService and its callers (TicketsService, InvitationsService,
/// MembersService, FeedbackService, SubscriptionsService) for exactly where each is
/// created. No type here exists without a real triggering event.
enum NotificationType {
  TICKET_CREATED
  TICKET_ASSIGNED
  TICKET_STATUS_CHANGED
  TICKET_RESOLVED
  TICKET_CLOSED
  TEAM_INVITATION_ACCEPTED
  TEAM_MEMBER_ROLE_CHANGED
  TEAM_MEMBER_REMOVED
  FEEDBACK_SUBMITTED
  PLAN_LIMIT_REACHED
}

/// Phase 8: a persistent, tenant- and recipient-scoped notification. `organizationId`
/// and `recipientId` are always set server-side from the verified auth context of the
/// action that triggered the notification (or, for PLAN_LIMIT_REACHED, from the
/// resolved list of active tenant owners) — never from client input. NotificationsService
/// re-enforces both on every read/write so a caller can never see or mutate another
/// user's or another tenant's notifications.
///
/// The related-entity ids (`ticketId`, `invitationId`, `feedbackFormId`) are plain,
/// unconstrained references rather than Prisma relations: a notification must remain
/// readable even after its related resource is gone, so there is deliberately no FK to
/// violate or cascade rule to maintain for them (the same free-form-reference reasoning
/// as TicketHistory.metadata above). Exactly zero or one of them is ever set, depending
/// on `type`. `feedbackFormId` (not a response id) because every feedback route in the
/// frontend is keyed by form, not by individual response — that's what "go look at the
/// responses this triggered" navigation actually needs.
model Notification {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A User is never actually hard-deleted (see the Ticket/TicketHistory comments
  // above) — onDelete: Cascade here exists only for the same Organization-delete
  // cascade-ordering reason, not because this fires in normal operation.
  recipientId String
  recipient   User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  read   Boolean   @default(false)
  readAt DateTime?

  ticketId       String?
  invitationId   String?
  feedbackFormId String?

  createdAt DateTime @default(now())

  /// Default "list my notifications, newest first" query.
  @@index([organizationId, recipientId, createdAt])
  /// Unread-only listing and the unread-count query.
  @@index([organizationId, recipientId, read, createdAt])
  @@map("notifications")
}
