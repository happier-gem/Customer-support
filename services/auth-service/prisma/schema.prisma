generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant company. Phase 1 only establishes the shape of this entity;
/// tenant-isolation enforcement (guards/middleware) is implemented in Phase 2.
/// Phase 3 adds the company-profile fields (logo, timezone) managed from
/// the org's own "/organizations/me" settings page.
model Organization {
  id        String   @id @default(uuid())
  name      String
  logoUrl   String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  tickets     Ticket[]

  @@map("organizations")
}

/// Roles are modeled now so the schema doesn't need to change shape in
/// Phase 2, but no RBAC/permission logic is enforced against this field yet.
enum UserRole {
  PLATFORM_ADMIN
  TENANT_OWNER
  SUPPORT_AGENT
  CUSTOMER
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TENANT_OWNER)

  /// Phase 3 team-member removal deactivates rather than deletes, to
  /// preserve historical data (e.g. anything the user authored later).
  /// A deactivated user can no longer log in.
  isActive Boolean @default(true)

  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  refreshTokenHash String?

  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sentInvitations Invitation[] @relation("InvitationInviter")

  ticketsAsCustomer   Ticket[]           @relation("TicketCustomer")
  ticketsAsAgent      Ticket[]           @relation("TicketAssignedAgent")
  ticketAttachments   TicketAttachment[]
  ticketHistoryEvents TicketHistory[]

  @@index([organizationId])
  @@index([emailVerificationTokenHash])
  @@index([passwordResetTokenHash])
  @@map("users")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// A pending (or resolved) invite for a teammate to join an organization
/// with a specific role. The raw token is emailed to the invitee and never
/// persisted — only its hash is stored, and it is looked up/compared the
/// same way password-reset/email-verification tokens are (see auth/utils/token.util.ts).
model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email String
  role  UserRole

  tokenHash String   @unique
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)

  invitedBy String
  inviter   User   @relation("InvitationInviter", fields: [invitedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketHistoryAction {
  CREATED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  UPDATED
  ATTACHMENT_ADDED
}

/// Phase 4: a customer's support ticket, always owned by exactly one
/// organization. `organizationId` is set once at creation from the caller's
/// verified auth context and is never re-derived from client input — every
/// query in TicketsService filters by it.
model Ticket {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // A User is never actually hard-deleted in this app (team-member removal
  // soft-deactivates — see User.isActive), so `onDelete: Cascade` here never
  // fires in production. It exists so that Organization -> User and
  // Organization -> Ticket -> TicketHistory/TicketAttachment, which both
  // cascade from the same Organization delete, don't race: without it,
  // Postgres can attempt to cascade-delete a User before the Ticket-side
  // cascade has removed the rows that still reference them, violating this
  // FK. Same reasoning applies to TicketAttachment.uploadedBy and
  // TicketHistory.actor below.
  customerId String
  customer   User   @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  assignedAgentId String?
  assignedAgent   User?   @relation("TicketAssignedAgent", fields: [assignedAgentId], references: [id])

  title       String
  description String
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  attachments TicketAttachment[]
  history     TicketHistory[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, assignedAgentId])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt])
  @@map("tickets")
}

/// A file attached to a ticket. `storedFileName` is a server-generated,
/// non-guessable name on disk — the client-supplied `fileName` is display-only
/// and never used to build a filesystem path (mirrors organizations/logo-upload.config.ts).
model TicketAttachment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  /// Denormalized from the parent ticket so attachment lookups can be
  /// tenant-scoped directly, without requiring a join for every access check.
  organizationId String

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  fileName       String
  storedFileName String
  mimeType       String
  size           Int

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([organizationId])
  @@map("ticket_attachments")
}

/// Append-only audit trail scoped to a single ticket (not the Phase 8 global
/// audit log). `organizationId` is denormalized for the same reason as on
/// TicketAttachment: tenant-scoped history queries without a join.
model TicketHistory {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  organizationId String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  action         TicketHistoryAction
  previousStatus TicketStatus?
  newStatus      TicketStatus?
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([organizationId])
  @@map("ticket_history")
}
